# Password for the /admin owner login (required)
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies (recommended; falls back to ADMIN_PASSWORD)
SESSION_SECRET=a-long-random-string

# Neon/Postgres connection string. Leave unset locally to use the embedded PGlite database in ./.pglite
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
